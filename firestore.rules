rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection check
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // User profiles: Users can manage their own profile; signed in users can view profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;
    }

    // School cloud state & backups: accessible by authenticated school personnel
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();

      match /state/{stateId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }

      match /backups/{backupId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if isSignedIn();
      }
    }
  }
}
